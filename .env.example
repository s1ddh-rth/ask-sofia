# Groq powers free text parsing only. It never decides a verdict.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Supabase is read and written from server routes only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The single demo studio login. Rule 8 allows this one and nothing more.
STUDIO_USER=sofia
STUDIO_PASSWORD=
SESSION_SECRET=

# The one tap Sign in as Sofia button on /login, for judging. Set to false to
# require the password. Anything other than false leaves it on.
DEMO_LOGIN=true
